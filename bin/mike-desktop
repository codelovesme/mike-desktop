#!/bin/sh
# Start Mike's desktop window. It is a client of the shared Mike service,
# which it starts (through systemd when the user unit is installed) if needed.
set -eu
launcher_dir=$(CDPATH= cd -- "$(dirname -- "$(readlink -f -- "$0")")" && pwd)
here=$launcher_dir
if [ ! -d "$here/ui" ]; then
    here=$(CDPATH= cd -- "$launcher_dir/.." && pwd)
fi
case "${1:-}" in
  --version|-V) printf 'Mike %s\n' "$(cat "$here/VERSION" 2>/dev/null || printf dev)"; exit 0 ;;
  --help|-h) printf 'Usage: mike\nConnects securely to https://apps.codeloves.me. Sign in with your account.\nLocal tasks run in the shared Mike service: see mike-service --help.\n'; exit 0 ;;
esac
[ "$#" -eq 0 ] || { echo 'mike: unexpected argument' >&2; exit 2; }
# The undocumented text-mode window (MIKE_DESKTOP_TEXT_UI=1) was the old
# companion's own terminal UI. With the companion moved into the shared
# service it no longer exists; say so rather than opening something else.
if [ -n "${MIKE_DESKTOP_TEXT_UI:-}" ]; then
    cat >&2 <<'MSG'
mike: the text-mode window (MIKE_DESKTOP_TEXT_UI) was retired in 0.5.
Unset MIKE_DESKTOP_TEXT_UI to open the Mike window: chat, history, apps,
voice (Speak, voice chat, read aloud) and Mike's approvals are there and on
the website. Local tasks now run in the shared Mike service (mike-service
status). A terminal client for the service is separate, planned work.
MSG
    exit 2
fi
host=${MIKE_DESKTOP_HOST_URL:-https://apps.codeloves.me}
case "$host" in
  https://apps.codeloves.me) ;;
  http://127.0.0.1:*|http://localhost:*)
    port=${host##*:}
    case "$port" in
      ''|*[!0-9]*) echo 'mike: local host URL needs a numeric port and no path' >&2; exit 2 ;;
    esac ;;
  *) echo 'mike: host URL must be https://apps.codeloves.me or HTTP on loopback' >&2; exit 2 ;;
esac
MIKE_DESKTOP_HOST_URL=$host
export MIKE_DESKTOP_HOST_URL
if [ -x /usr/bin/python3 ]; then
    exec /usr/bin/python3 "$here/ui/desktop_webview.py"
fi
echo 'mike: Python 3 and WebKitGTK are needed for the desktop window' >&2
exit 1
