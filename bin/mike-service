#!/bin/sh
# Mike's shared local service: one per OS user, normally run by systemd.
#   mike-service run          run in the foreground (what the user unit runs)
#   mike-service start|stop|status|restart
#   mike-service install-unit | uninstall-unit
#   mike-service enroll --account EMAIL | unenroll | grant add|list|revoke
set -eu
launcher_dir=$(CDPATH= cd -- "$(dirname -- "$(readlink -f -- "$0")")" && pwd)
here=$launcher_dir
if [ ! -d "$here/service" ]; then
    here=$(CDPATH= cd -- "$launcher_dir/.." && pwd)
fi
command=${1:-}
case "$command" in
  --version|-V) printf 'mike-service %s (local protocol 1; Code >= 2.12.1 < 2.15.0)\n' "$(cat "$here/VERSION" 2>/dev/null || printf dev)"; exit 0 ;;
  --help|-h|'') sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  run) ;;
  *)
    [ -x /usr/bin/python3 ] || { echo 'mike-service: Python 3 is needed for service control' >&2; exit 1; }
    exec /usr/bin/python3 "$here/client/service_control.py" "$here" "$@" ;;
esac
[ "$#" -eq 1 ] || { echo 'mike-service: run takes no arguments' >&2; exit 2; }
# The host URL is validated again by the service itself.
host=${MIKE_SERVICE_HOST_URL:-${MIKE_DESKTOP_HOST_URL:-https://apps.codeloves.me}}
MIKE_SERVICE_HOST_URL=$host
export MIKE_SERVICE_HOST_URL
# The bundled modules are Code 2.12.1 releases (module ABI 1): a Code from
# 2.12.1 up to, not including, 2.15.0 loads them. Use the named interpreter,
# else the Code CDLVSM resolved for this package (.cdlvsm-deps/code, which may
# be installed beside a newer active Code), else CDLVSM's active one; each
# is checked, never guessed past.
requirement='Code >= 2.12.1 and < 2.15.0 (module ABI 1)'
compatible() {
    version=$("$1" --version 2>/dev/null | sed -n 's/^Code v\([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\).*/\1/p')
    [ -n "$version" ] || return 1
    major=${version%%.*}; rest=${version#*.}; minor=${rest%%.*}; patch=${rest#*.}
    [ "$major" -eq 2 ] || return 1
    [ "$minor" -ge 12 ] && [ "$minor" -le 14 ] || return 1
    [ "$minor" -gt 12 ] || [ "$patch" -ge 1 ]
}
if [ -n "${MIKE_SERVICE_CODE_BIN:-}" ]; then
    interpreter=$MIKE_SERVICE_CODE_BIN
    [ -x "$interpreter" ] && compatible "$interpreter" || {
        echo "mike-service: MIKE_SERVICE_CODE_BIN ($interpreter) is not $requirement" >&2
        exit 1
    }
elif [ -x "$here/.cdlvsm-deps/code/code" ] && compatible "$here/.cdlvsm-deps/code/code"; then
    interpreter="$here/.cdlvsm-deps/code/code"
elif [ -x "$here/../../code/current/code" ] && compatible "$here/../../code/current/code"; then
    interpreter="$here/../../code/current/code"
else
    echo "mike-service: needs $requirement; set MIKE_SERVICE_CODE_BIN to one (CDLVSM's current Code is not compatible or absent)" >&2
    exit 1
fi
cd "$here/service"
exec "$interpreter" run main.code
