| Local file workflow. The root and query are supplied by the person in the
| desktop window. A remote task is only an invitation to start this workflow.

FindLocalFile { root, query } =>
    if root ∉ String or query ∉ String
        return FileRefused { reason = "choose a folder and enter a filename" }
    emit Length { value = root } to core get root_length
    emit Length { value = query } to core get query_length
    if root_length.value < 2 or root_length.value > 500 or root[0, 1) ≠ "/"
        return FileRefused { reason = "choose an absolute folder path" }
    if query_length.value < 2 or query_length.value > 100
        return FileRefused { reason = "enter 2 to 100 filename characters" }
    emit Contains { text = query, needle = "/" } to this get slash
    if slash.yes
        return FileRefused { reason = "enter a filename, not a path" }
    emit Run { command = "find", args = ["-P", root, "-maxdepth", "6", "-type", "f", "-iname", "*" + query + "*", "-print", "-quit"] } to proc get found
    if found ∈ Exception or not found.success
        return FileRefused { reason = "could not search that folder" }
    emit Length { value = found.stdout } to core get output_length
    if output_length.value = 0
        return FileRefused { reason = "no matching file in that folder" }
    path = found.stdout
    if found.stdout[output_length.value - 1, output_length.value) = "\n"
        path = found.stdout[0, output_length.value - 1)
    if path = ""
        return FileRefused { reason = "no matching file in that folder" }
    return FileFound { path = path }

| This handler is called only after a fresh local confirmation of the exact
| path. It does not accept a server-supplied path.
OpenLocalFile { path, root } =>
    if path ∉ String or path = ""
        return FileRefused { reason = "no file was selected" }
    emit FileInChosenFolder { path = path, root = root } to this get scope
    if not scope.ok
        return FileRefused { reason = "the file changed or left the chosen folder" }
    | Pass the verified descriptor to the document portal. A pathname swap
    | after the review cannot redirect the file it receives.
    emit Run { command = "/usr/bin/python3", args = ["ui/secure_open.py", root, path] } to proc get opened
    if opened ∈ Exception or not opened.success
        return FileRefused { reason = "the document portal could not open the reviewed file" }
    return FileOpened { path = path }

| Recheck the chosen folder and exact candidate immediately before opening.
| `find -P` avoids following links while searching; this check also rejects a
| file whose resolved target lies outside the chosen folder.
FileInChosenFolder { path, root } =>
    if root ∉ String or root = "" or path ∉ String or path = ""
        return Scope { ok = false }
    emit Run { command = "realpath", args = ["-e", "--", root] } to proc get selected
    emit Run { command = "realpath", args = ["-e", "--", path] } to proc get actual
    if selected ∈ Exception or actual ∈ Exception or not selected.success or not actual.success
        return Scope { ok = false }
    emit Length { value = selected.stdout } to core get folder_size
    emit Length { value = actual.stdout } to core get file_size
    if folder_size.value < 2 or file_size.value < 3
        return Scope { ok = false }
    if selected.stdout[folder_size.value - 1, folder_size.value) ≠ "\n" or actual.stdout[file_size.value - 1, file_size.value) ≠ "\n"
        return Scope { ok = false }
    folder = selected.stdout[0, folder_size.value - 1)
    file = actual.stdout[0, file_size.value - 1)
    emit Contains { text = folder, needle = "\n" } to this get folder_newline
    emit Contains { text = file, needle = "\n" } to this get file_newline
    if folder_newline.yes or file_newline.yes
        return Scope { ok = false }
    prefix = folder + "/"
    if folder = "/", prefix = "/"
    emit Length { value = prefix } to core get prefix_size
    emit Length { value = file } to core get actual_size
    if actual_size.value ≤ prefix_size.value
        return Scope { ok = false }
    if file[0, prefix_size.value) ≠ prefix
        return Scope { ok = false }
    return Scope { ok = true }

Contains { text, needle } =>
    emit Length { value = text } to core get text_length
    emit Length { value = needle } to core get size
    if size.value = 0
        return ContainsResult { yes = true }
    if size.value > text_length.value
        return ContainsResult { yes = false }
    i = 0
    loop
        if i + size.value > text_length.value
            break
        if text[i, i + size.value) = needle
            return ContainsResult { yes = true }
        i = i + 1
    return ContainsResult { yes = false }
